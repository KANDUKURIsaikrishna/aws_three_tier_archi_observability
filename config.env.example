# ─────────────────────────────────────────────────────────────────────────────
# config.env.example — Project configuration template
#
# One-time local setup:
#   1. cp config.env.example config.env
#   2. Fill in the values below
#   3. python3 scripts/configure.py
#
# config.env is gitignored — never commit it.
# This file (config.env.example) IS in git as a template.
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS ───────────────────────────────────────────────────────────────────────
# 12-digit AWS account ID
# Find it: aws sts get-caller-identity --query Account --output text
AWS_ACCOUNT_ID=123456789012

# AWS region where the cluster lives. Any valid AWS region works — AZs,
# ECR registry URL, and the ClusterSecretStore's region are all derived
# from this, nothing else is hardcoded to us-west-1.
#
# If you set this to anything other than us-west-1, also set a matching
# AWS_REGION repo Variable in GitHub — Settings → Secrets and variables →
# Actions → Variables tab (NOT Secrets — this isn't sensitive). Otherwise
# CI defaults to us-west-1 and builds/pushes images to the wrong region's
# ECR while Terraform provisions elsewhere.
AWS_REGION=us-west-1

# DR secondary region -- only matters if you set enable_dr_replication=true
# in terraform.tfvars/environments/*.tfvars (off by default). Optional --
# defaults to us-west-2 if unset, matching variables.tf's own default, so
# leaving this out changes nothing. Independent of AWS_REGION on purpose:
# "where I deploy" and "where my backups replicate to" are different
# questions, not the same knob.
SECONDARY_REGION=us-west-2

# ── Domain ────────────────────────────────────────────────────────────────────
# Your registered domain.  The app will live at:
#   https://bookstore.<DOMAIN>
#   https://api.bookstore.<DOMAIN>
DOMAIN=your-domain.com

# ── GitHub ────────────────────────────────────────────────────────────────────
# GitHub repo in  owner/repo  format.
# Used in the OIDC IAM role trust policy and in argocd/application.yaml.
GITHUB_REPO=YOUR_GITHUB_USERNAME/aws_three_tier_code

# Branch ArgoCD deploys from (k8s/argocd/application.yaml and
# applicationset-microservices.yaml's targetRevision). Optional -- defaults
# to "main" if unset. Only change this if you're deploying from a fork or a
# long-lived branch other than main.
GITHUB_BRANCH=main

# ── Alerting ──────────────────────────────────────────────────────────────────
# Email address Alertmanager sends alert notifications to (SES SMTP). Also
# used as the SES sender identity -- SES sandbox mode requires both sender
# and recipient to be verified, so using the same address for both means one
# verification email to click after the first apply.
ALERT_EMAIL=you@example.com
