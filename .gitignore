# Project config — real values live here, never committed
config.env

# Env files — never commit secrets
.env
.env.local
.env.*.local
.env.prod
.env.staging
.env.production
*.env.*
!*.env.example

# Terraform variable values — generated by scripts/configure.py
terraform.tfvars
terraform.tfvars.json

# Per-environment overrides — real values, keep the .example templates in git
terraform/environments/*.tfvars
!terraform/environments/*.tfvars.example

# Python
__pycache__/
*.pyc

# Node
node_modules/
npm-debug.log*

# React build output
client/build/

# Terraform state — use remote backend (S3 + DynamoDB)
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
# tfplan* (not just the bare "tfplan"/"*.tfplan" names) -- plan files can
# contain sensitive resource values in plaintext (unlike `terraform show
# -json`'s output, the raw plan file is never redacted) and easy to end up
# with tfplan1, tfplan156, etc. from repeated `-out=tfplan<N>` runs.
tfplan*
*.tfplan
# NOTE: .terraform.lock.hcl is intentionally NOT ignored — commit it like package-lock.json

# K8s secrets — use Sealed Secrets or External Secrets Operator
k8s/secrets/db-secret.yaml

# SSH private keys — never commit key material
id_*
*.pem
*.key
*.p12
*.pfx

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
kubectl.exe

# Claude Code — local AI assistant config (not team config)
.claude/

# graphify — local knowledge-graph output, never committed
graphify-out/

# Gemini diagram-generation prompts — local scratch, never committed
architecture-diagram-prompt.txt
cicd-diagram-prompt.txt
